# Copy to .env. Never commit .env.
LLM_PROVIDER=ollama              # ollama | anthropic
OLLAMA_MODEL=llama3.1:8b
OLLAMA_URL=http://localhost:11434

# Only used when LLM_PROVIDER=anthropic. Leave blank for Ollama.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE_WORDS=120
CHUNK_OVERLAP_WORDS=25
TOP_K=4

# Passphrase for the simulated approver keys in keys/ (only needed to sign documents).
# Use your own value; never commit it.
RAG_SHIELD_KEY_PASSPHRASE=
# Optional: where the audit-log sealing key lives (default keys/log_hmac.key).
RAG_SHIELD_LOG_KEY=
# Demo step-up PIN (4-8 digits) for out-of-region sensitive documents (scenario F).
# Leave empty to disable step-up: out-of-region sensitive documents then stay locked.
RAG_SHIELD_DEMO_PIN=
